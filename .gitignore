# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Temporary
tmp/
temp/

# Local-only compose files. Operators copy docker-compose.yaml.example to
# docker-compose.yaml and edit it for their environment; a
# docker-compose.override.yaml (e.g. building one service from a local
# checkout) is merged automatically by docker compose and stays local too.
docker-compose.yaml
docker-compose.override.yaml
compose.yaml
compose.override.yaml

# Local environment file with real values. Operators copy .env.example to
# .env; .env.example stays in git as the documented template.
.env
.env.*
!.env.example

# Runtime-generated certificates and keys. ldap-certs writes the test
# directory CA to ldap/ca.pem; anything else certificate-shaped under ldap/
# or a trusted copy of the edge certificate is per-machine output.
ldap/ca.pem
ldap/**/*.pem
ldap/**/*.key
ldap/**/*.crt
ldap/**/*.srl
*.crt
*.csr
freya-dev-edge.crt
