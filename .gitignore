# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# Temporary
tmp/
temp/

# Local-only compose files. Contributors copy *.example to the unsuffixed
# names and edit for their environment (cert fingerprints, image tags,
# secrets, port overrides) — keep local edits out of version control.
docker-compose.yaml
docker-compose.dev.yaml

# Local environment file with real secrets. Contributors copy .env.example
# to .env and fill in real values. .env.example stays in git as the
# template; .env is excluded.
.env
.env.bak
!.env.example

# Bind-mounted SSL certs for the frontend. Per-deployment files,
# never check them in. The directory itself is created by the operator
# (see MIGRATION.md "Restoring the frontend cert from lcm-data").
certs/
