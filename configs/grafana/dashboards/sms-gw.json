{
  "uid": "tangra-sms-gw",
  "title": "Tangra · SMS Gateway",
  "tags": ["tangra", "sms-gw"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(sms_gw_send_total, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sends / sec (5m)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(sms_gw_send_total{provider=~\"$provider\"}[5m]))",
          "legendFormat": "rate"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Send success rate (5m)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(sms_gw_send_total{provider=~\"$provider\",outcome=\"ok\"}[5m])) / clamp_min(sum(rate(sms_gw_send_total{provider=~\"$provider\"}[5m])), 1e-9)",
          "legendFormat": "success"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Send p95 latency (5m)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sms_gw_send_duration_seconds_bucket{provider=~\"$provider\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DLRs / sec (5m)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(sms_gw_dlr_received_total[5m]))", "legendFormat": "rate" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Send rate by outcome",
      "description": "Per-provider send rate broken down by outcome label (ok / provider_error / blocked / validation_error).",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(sms_gw_send_total{provider=~\"$provider\"}[1m]))",
          "legendFormat": "{{provider}} · {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "fillOpacity": 10, "stacking": { "mode": "normal", "group": "A" } }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right", "showLegend": true } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Send latency (p50 / p95 / p99)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(sms_gw_send_duration_seconds_bucket{provider=~\"$provider\"}[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(sms_gw_send_duration_seconds_bucket{provider=~\"$provider\"}[5m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(sms_gw_send_duration_seconds_bucket{provider=~\"$provider\"}[5m])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "DLR rate by carrier status",
      "description": "Inbound delivery receipt rate grouped by reported status. Voicecom mapping: 1=delivered, 2=delivery_failed, 8=smsc_delivered, 16=rejected.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(sms_gw_dlr_received_total[1m]))",
          "legendFormat": "status {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 15, "stacking": { "mode": "normal", "group": "A" } }
        }
      },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 21,
      "type": "piechart",
      "title": "DLR mix (last 1h)",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (increase(sms_gw_dlr_received_total[1h]))",
          "legendFormat": "status {{status}}"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "right" } }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Outbound webhook delivery",
      "description": "Per-client DLR webhook delivery attempts. \"dropped\" indicates the per-client outbound queue was full.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(sms_gw_webhook_delivery_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } } },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Login attempts by outcome",
      "description": "Authentication outcomes on the public /hermes/v1/login endpoint. A spike in bad_credentials may indicate credential stuffing.",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(sms_gw_auth_login_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } } },
      "options": { "legend": { "displayMode": "table", "placement": "right" } }
    },
    {
      "id": 40,
      "type": "timeseries",
      "title": "Process · CPU & memory",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"sms-gw\"}[1m])",
          "legendFormat": "CPU (cores)"
        },
        {
          "expr": "process_resident_memory_bytes{job=\"sms-gw\"}",
          "legendFormat": "RSS"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "axisPlacement": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "RSS" }, "properties": [{ "id": "unit", "value": "bytes" }] },
          { "matcher": { "id": "byName", "options": "CPU (cores)" }, "properties": [{ "id": "unit", "value": "none" }] }
        ]
      }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Go runtime · goroutines & GC",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "go_goroutines{job=\"sms-gw\"}", "legendFormat": "goroutines" },
        { "expr": "rate(go_gc_duration_seconds_count{job=\"sms-gw\"}[1m])", "legendFormat": "gc /s" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
