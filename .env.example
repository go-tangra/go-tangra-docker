# =============================================================================
# Local environment for docker compose (go-tangra v4). Copy to .env and edit:
#   cp .env.example .env
# .env is in .gitignore; edits there are local-only. Every variable below is
# optional: docker-compose.yaml falls back to the value shown here when it is
# unset, so the stack also runs with no .env at all. To change the defaults
# every operator inherits, edit .env.example AND docker-compose.yaml.example.
#
# Credentials that live inside the mounted configs/*.yaml files and
# init-db.sql are NOT templated here; see "Credentials inside configs/" in
# README.md. The credential variables below must stay in step with them.
# =============================================================================

# ---------------------------------------------------------------------------
# Compose project
# ---------------------------------------------------------------------------

# Project name: prefixes containers, networks and volumes. Keep freya-stack
# for an existing deployment, otherwise compose creates a new, empty set of
# volumes (database, CA, tokens, SVID state).
COMPOSE_PROJECT_NAME=freya-stack

# Optional profiles to enable, comma-separated:
#   ldap    - seeded test OpenLDAP for the auth directory import
#   metrics - Prometheus scraping PowerDNS for the dns dashboard
#COMPOSE_PROFILES=ldap,metrics

# ---------------------------------------------------------------------------
# Common runtime knobs
# ---------------------------------------------------------------------------

# Timezone for every long-running container. One-shot init jobs keep the
# image default (UTC). Images without tzdata fall back to UTC.
TZ=UTC

# Email of the first operator. auth-bootstrap creates the invitation; the
# accept link is printed in its logs (and by up.sh) and mailed to Mailpit.
OPERATOR_EMAIL=admin@example.org

# Group id of the Docker socket on the host. The dns service joins it so a
# configuration save can restart the PowerDNS containers. up.sh detects it
# (stat -c %g /var/run/docker.sock) when it is unset; leave it commented out
# to keep that detection.
#DOCKER_GID=999

# Host path of the Docker socket mounted into dns (read-write; root-equivalent
# on the host - dev only). Point it at a rootless or proxied socket if needed.
DOCKER_SOCKET=/var/run/docker.sock

# ---------------------------------------------------------------------------
# Mesh certificates (SVIDs issued by lcm)
# ---------------------------------------------------------------------------

# Lifetime of the bootstrap SVIDs minted by lcm-bootstrap and the renewer.
CERT_TTL=12h

# Seconds between renewer runs (renew first, then sleep). Keep it well below
# CERT_TTL. Integrity mode: CERT_TTL=5m RENEW_INTERVAL=210.
RENEW_INTERVAL=21600

# ---------------------------------------------------------------------------
# go-tangra service images
#   ${IMAGE_REGISTRY}/go-tangra-<repo>:${TANGRA_VERSION}
# All services share one version. Override IMAGE_REGISTRY when mirroring
# the GHCR images into a private registry.
# ---------------------------------------------------------------------------
IMAGE_REGISTRY=ghcr.io/go-tangra
TANGRA_VERSION=4.0.0

# Per-service full image reference (repository:tag), e.g. to pin one service
# to another release or run a locally built image. Unset = the pattern above.
#AUTH_IMAGE=ghcr.io/go-tangra/go-tangra-auth:4.0.0
#GATEWAY_IMAGE=ghcr.io/go-tangra/go-tangra-portal:4.0.0
#LCM_IMAGE=ghcr.io/go-tangra/go-tangra-lcm:4.0.0
#NOTIFICATION_IMAGE=ghcr.io/go-tangra/go-tangra-notification:4.0.0
#WARDEN_IMAGE=ghcr.io/go-tangra/go-tangra-warden:4.0.0
#DEPLOYER_IMAGE=ghcr.io/go-tangra/go-tangra-deployer:4.0.0
#PAPERLESS_IMAGE=ghcr.io/go-tangra/go-tangra-paperless:4.0.0
#INVENTORY_IMAGE=ghcr.io/go-tangra/go-tangra-inventory:4.0.0
#IPAM_IMAGE=ghcr.io/go-tangra/go-tangra-ipam:4.0.0
#ASSET_IMAGE=ghcr.io/go-tangra/go-tangra-asset:4.0.0
#TICKET_IMAGE=ghcr.io/go-tangra/go-tangra-ticket:4.0.0
#DNS_IMAGE=ghcr.io/go-tangra/go-tangra-dns:4.0.0

# ---------------------------------------------------------------------------
# Third-party images (full references; the PowerDNS and ldap-certs images are
# pinned by digest)
# ---------------------------------------------------------------------------
TIMESCALEDB_IMAGE=timescale/timescaledb:latest-pg16
VALKEY_IMAGE=valkey/valkey:8
OPENFGA_IMAGE=openfga/openfga:v1.20.0
VAULT_IMAGE=hashicorp/vault:1.18
MAILPIT_IMAGE=axllent/mailpit:latest
RUSTFS_IMAGE=rustfs/rustfs:latest
TIKA_IMAGE=apache/tika:latest-full
GOTENBERG_IMAGE=gotenberg/gotenberg:8
PEBBLE_IMAGE=ghcr.io/letsencrypt/pebble:latest
PDNS_AUTH_IMAGE=powerdns/pdns-auth-49@sha256:b554df74bbde1afa7caedad4af9c91378be6d46d05807d089b3c7c443002e684
PDNS_RECURSOR_IMAGE=powerdns/pdns-recursor-53@sha256:175d551ce52fa5c6bf0a0c19d6872791a4c928f6fb00a696534c1174693da3f7
# Init jobs (certificates, generated secrets, volume ownership).
ALPINE_IMAGE=alpine:3.20
# Profile ldap: certificate job and the locally built test directory image.
LDAP_CERTS_IMAGE=alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
OPENLDAP_IMAGE=go-tangra/openldap-test:dev
# Profile metrics.
PROMETHEUS_IMAGE=prom/prometheus:v3.5.0

# ---------------------------------------------------------------------------
# Published host ports
#   *_BIND  host address to bind; empty = every interface (IPv4 and IPv6),
#           e.g. 127.0.0.1 to keep a port on loopback
#   *_PORT  host port
# Mailpit, RustFS, Vault, Prometheus and the PowerDNS HTTP APIs are not
# published; add ports in a docker-compose.override.yaml if you need them.
# ---------------------------------------------------------------------------

# Gateway edge: web console and API (https://localhost:8443).
EDGE_BIND=
EDGE_PORT=8443

# ticket off-mesh inbound mail edge (TLS, relay token).
TICKET_INBOUND_BIND=
TICKET_INBOUND_PORT=9957

# inventory off-mesh ingest edge for endpoint agents.
INVENTORY_INGEST_BIND=
INVENTORY_INGEST_PORT=9977

# Pebble test ACME CA directory (https://localhost:14000/dir).
PEBBLE_BIND=
PEBBLE_PORT=14000

# PowerDNS Authoritative and Recursor DNS (udp+tcp). Loopback only by
# default; host :53 usually belongs to systemd-resolved and :5353 to mDNS.
PDNS_AUTH_BIND=127.0.0.1
PDNS_AUTH_PORT=5300
PDNS_RECURSOR_BIND=127.0.0.1
PDNS_RECURSOR_PORT=5301

# ---------------------------------------------------------------------------
# Infrastructure credentials defined in the compose file. Development values:
# change them for anything but a workstation, together with the matching
# entries in configs/*.yaml and init-db.sql (see README.md).
# POSTGRES_PASSWORD only takes effect when the database is first created.
# ---------------------------------------------------------------------------

# TimescaleDB superuser password; also in OpenFGA's datastore URI and in every
# configs/<service>.yaml migrate_dsn.
POSTGRES_PASSWORD=dev

# Valkey default-user password and the password of every per-service ACL user
# (configs/<service>.yaml valkey.password).
VALKEY_PASSWORD=dev

# OpenFGA preshared API key (configs/auth.yaml openfga.preshared_key).
OPENFGA_PRESHARED_KEY=dev-openfga-key

# RustFS (S3) access keys (configs/{paperless,asset,ticket}.yaml
# access_key / secret_key).
RUSTFS_ACCESS_KEY=paperless
RUSTFS_SECRET_KEY=paperless-dev-secret

# Root token of the dev-mode Vault behind warden (vault-init uses it to create
# warden's AppRole; warden itself authenticates with the AppRole).
VAULT_DEV_ROOT_TOKEN=dev-root

# ---------------------------------------------------------------------------
# prod-init.sh inputs (production only; see PRODUCTION.md §4.2). The script reads
# these from .env when they are not set in the environment. Leave them empty for
# the development stack. SMTP_PASSWORD is a real secret: .env is git-ignored and
# prod-init.sh sets it to mode 0600.
# ---------------------------------------------------------------------------
# Public DNS name of the edge (bare name: no scheme, no port).
PUBLIC_HOST=
# Public port browsers use; 443 means the origin carries no port.
PUBLIC_PORT=443
# Real mail relay; 465 = implicit TLS, 587 = STARTTLS (no other port is accepted).
SMTP_HOST=
SMTP_PORT=587
# Relay login; leave both empty for an IP-allow-listed relay.
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address for auth and warden mail; its domain is the mail domain.
MAIL_FROM=

# ---------------------------------------------------------------------------
# HTTP -> HTTPS redirect (production overlay, service http-redirect). Port 80
# answers every plain-HTTP request with a 301 to PUBLIC_ORIGIN + path.
# PUBLIC_ORIGIN is written by prod-init.sh (https://PUBLIC_HOST, plus
# :PUBLIC_PORT when that is not 443).
# ---------------------------------------------------------------------------
HTTP_BIND=
HTTP_PORT=80
HTTP_REDIRECT_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine
PUBLIC_ORIGIN=
